__pycache__/
*.pyc

# PyInstaller build output -- regenerated by `py -3.11 -m PyInstaller build_specs/*.spec`,
# not source.
Windows/build_work/
Windows/build_dist/

# Inno Setup output -- regenerated by `iscc installer/ClaudeStatusLight.iss`
# (requires build_dist/ above to exist first). ClaudeStatusLightSetup.exe is
# what actually ships to customers, but stays out of git too -- a ~30MB
# rebuildable binary, not source.
Windows/installer_output/

# Browser extension builds -- regenerated by `py -3.11 extension/build.py` --
# and the extension tests' npm packages.
extension/dist/
extension/tests/node_modules/
