{
  "version": 1,
  "_about": "How MAICA recognises each AI app. Apps change their UI often, so this lives in data, not code: the desktop app serves it to the browser extension (GET /rules), and a newer copy can be dropped into the config folder (rules.json there overrides this file) without reinstalling. Labels marked unverified are best guesses -- see the README's 'Tuning detection' section.",

  "apps": {
    "claude":      {"name": "Claude",          "color": "D97757"},
    "claude_code": {"name": "Claude Code",     "color": "D97757"},
    "chatgpt":     {"name": "ChatGPT",         "color": "10A37F"},
    "codex":       {"name": "Codex",           "color": "7C8BA1"},
    "gemini":      {"name": "Gemini",          "color": "4C8DF6"},
    "aistudio":    {"name": "AI Studio",       "color": "4C8DF6"},
    "copilot":     {"name": "Copilot",         "color": "2EB8E6"},
    "perplexity":  {"name": "Perplexity",      "color": "20B8CD"},
    "grok":        {"name": "Grok",            "color": "B4B9C2"},
    "deepseek":    {"name": "DeepSeek",        "color": "4D6BFE"},
    "mistral":     {"name": "Le Chat",         "color": "FA520F"},
    "meta":        {"name": "Meta AI",         "color": "0A7CFF"},
    "poe":         {"name": "Poe",             "color": "7A6CF0"},
    "huggingchat": {"name": "HuggingChat",     "color": "FFC93C"},
    "qwen":        {"name": "Qwen",            "color": "7B6CF6"},
    "kimi":        {"name": "Kimi",            "color": "A0A6B0"},
    "lmstudio":    {"name": "LM Studio",       "color": "8E7CF8"},
    "ollama":      {"name": "Ollama",          "color": "C8CCD2"}
  },

  "limit_banner": "^\\W{0,3}(?:you['’]?ve (?:hit|reached|used up) (?:your|the|our)\\b.{0,60}?\\b(?:limit|cap|messages|usage)\\b|you (?:have )?(?:hit|reached) (?:your|the|our)\\b.{0,60}?\\b(?:limit|cap)\\b|you['’]?re out of\\b|you are out of\\b|out of (?:free )?messages\\b|(?:claude (?:ai )?)?(?:usage|message|rate|5-hour|five-hour|weekly|daily|plan) limit reached\\b|limit reached\\b|credit balance is too low\\b|your (?:org|organization) is out of usage\\b)",

  "_sites_about": "Browser extension. A page is RUNNING while a visible button matching 'stop' (selectors, or a label matching stop_label) is on screen; QUESTION while a 'question' selector matches; THINKING while running and an element matching 'thinking' selectors/text is in the page; out of tokens while a short text near the message box (limit_scope) matches limit_banner. Every site also gets the generic stop-button check, so a site missing specifics still shows working/done.",
  "stop_label": "^\\s*stop\\b(?! sharing| recording| dictation| voice)",
  "sites": [
    {"id": "chatgpt", "app": "chatgpt", "hosts": ["chatgpt.com", "chat.openai.com"],
     "stop": ["button[data-testid='stop-button']", "button[aria-label^='Stop']"],
     "question": ["input[aria-label^='Custom answer for']", "textarea[aria-label^='Custom answer for']"],
     "thinking": {"selectors": ["[data-testid*='thinking']"], "text": "^(Thinking|Reasoning)\\b"},
     "limit_scope": "form, [role='alert'], [role='status'], [data-testid*='limit']"},
    {"id": "claude", "app": "claude", "hosts": ["claude.ai"],
     "stop": ["button[aria-label='Stop response']", "button[aria-label^='Stop']"],
     "question": ["[placeholder*='Reply directly' i]", "[data-placeholder*='Reply directly' i]"],
     "thinking": {"text": "^Thinking\\b"},
     "limit_scope": "fieldset, form, [role='alert'], [role='status']"},
    {"id": "gemini", "app": "gemini", "hosts": ["gemini.google.com"],
     "stop": ["button[aria-label^='Stop']", "button.stop"],
     "thinking": {"text": "^(Thinking|Show thinking)\\b"},
     "limit_scope": "input-area-v2, .input-area, [role='alert'], [role='status']"},
    {"id": "aistudio", "app": "aistudio", "hosts": ["aistudio.google.com"],
     "stop": ["button[aria-label^='Stop']", "run-button button.stoppable"],
     "thinking": {"text": "^Thinking\\b"}},
    {"id": "copilot", "app": "copilot", "hosts": ["copilot.microsoft.com"],
     "stop": ["button[aria-label^='Stop']", "button[title^='Stop']"],
     "limit_scope": "form, [role='alert'], [role='status']"},
    {"id": "perplexity", "app": "perplexity", "hosts": ["www.perplexity.ai", "perplexity.ai"],
     "stop": ["button[aria-label^='Stop']", "button[data-testid='stop-generating-response-button']"]},
    {"id": "grok", "app": "grok", "hosts": ["grok.com"],
     "stop": ["button[aria-label^='Stop']"],
     "thinking": {"text": "^Thinking\\b"}},
    {"id": "deepseek", "app": "deepseek", "hosts": ["chat.deepseek.com"],
     "stop": ["div[role='button'][aria-label^='Stop']"],
     "thinking": {"text": "^Thinking\\b"}},
    {"id": "mistral", "app": "mistral", "hosts": ["chat.mistral.ai"],
     "stop": ["button[aria-label^='Stop']"]},
    {"id": "meta", "app": "meta", "hosts": ["www.meta.ai", "meta.ai"],
     "stop": ["div[role='button'][aria-label^='Stop']", "button[aria-label^='Stop']"]},
    {"id": "poe", "app": "poe", "hosts": ["poe.com"],
     "stop": ["button[class*='StopButton']", "button[aria-label^='Stop']"]},
    {"id": "huggingchat", "app": "huggingchat", "hosts": ["huggingface.co"], "path": "^/chat",
     "stop": ["button[aria-label^='Stop']"]},
    {"id": "qwen", "app": "qwen", "hosts": ["chat.qwen.ai"],
     "stop": ["button[aria-label^='Stop']", "button.stop-button"]},
    {"id": "kimi", "app": "kimi", "hosts": ["www.kimi.com", "kimi.com"],
     "stop": ["button[aria-label^='Stop']"]}
  ],

  "_desktop_about": "Generic desktop-app backends (desktop_rules_backend.py): Windows UI Automation by window title (win_title), macOS Accessibility by app name (mac_app); an app with only one of them is followed on that system only. RUNNING while a button whose name matches 'stop' exists. All unverified.",
  "desktop": [
    {"id": "lmstudio", "app": "lmstudio", "win_title": "^LM Studio", "mac_app": "LM Studio",
     "stop": "^(Stop|Stop generating|Stop Generating)$"},
    {"id": "ollama_app", "app": "ollama", "win_title": "^Ollama$", "mac_app": "Ollama",
     "stop": "^Stop\\b"},
    {"id": "perplexity_app", "app": "perplexity", "win_title": "^Perplexity$", "mac_app": "Perplexity",
     "stop": "^Stop\\b"},
    {"id": "copilot_mac", "app": "copilot", "mac_app": "Copilot",
     "stop": "^Stop\\b"}
  ]
}
