{
  "manifest_version": 3,
  "name": "MAICA",
  "version": "1.1.0",
  "description": "Shows what your AI chats are doing on MAICA, your desk robot: working, thinking, asking you something, done, or out of tokens.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MAICA"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://chat.openai.com/*",
    "https://chat.qwen.ai/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://copilot.microsoft.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://huggingface.co/chat*",
    "https://kimi.com/*",
    "https://meta.ai/*",
    "https://perplexity.ai/*",
    "https://poe.com/*",
    "https://www.kimi.com/*",
    "https://www.meta.ai/*",
    "https://www.perplexity.ai/*",
    "http://127.0.0.1:47823/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://chat.openai.com/*",
        "https://chat.qwen.ai/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://huggingface.co/chat*",
        "https://kimi.com/*",
        "https://meta.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://www.kimi.com/*",
        "https://www.meta.ai/*",
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}